# ==============================================================================
# LUMORA BACKEND ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local backend directory (or on server at /var/www/skholar/.env).
# 2. Fill in the real credentials after rotating your keys in service dashboards.
# 3. NEVER commit your actual '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Generate a secret key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,skholar.onrender.com,skholar.site,www.skholar.site,api.skholar.site

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (AWS RDS PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgres://<USERNAME>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
DATABASE_URL=postgres://skholar_admin:your_rds_password@skholar-db.cq5i8g82y6ll.us-east-1.rds.amazonaws.com:5432/postgres

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (Media & Image Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. ONESIGNAL (Push Notifications)
# ------------------------------------------------------------------------------
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# ------------------------------------------------------------------------------
# 5. AI ENGINE CONFIGURATION (Groq, DeepSeek, HuggingFace)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key

# ------------------------------------------------------------------------------
# 6. AWS & BEDROCK AI CONFIGURATION
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION_NAME=us-east-1

# ------------------------------------------------------------------------------
# 7. EMAIL CONFIGURATION (Zoho SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST_USER=theproblemsolvers@skholar.site
EMAIL_HOST_PASSWORD=your_zoho_email_password
DEFAULT_FROM_EMAIL=Skholar <theproblemsolvers@skholar.site>

# ------------------------------------------------------------------------------
# 8. CORS ORIGINS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://skholar.site,https://www.skholar.site,http://localhost:8000,http://localhost:3000
